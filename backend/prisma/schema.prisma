generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum ChannelType {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  X
  TINDER
}

enum ChannelStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING_REVIEW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  SYSTEM
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  X
  TINDER
  REFERRAL
  MANUAL
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum KnowledgeType {
  FAQ
  PRODUCT
  SERVICE
  DOCUMENT
  WEBSITE
  CUSTOM
}

enum AIAgentType {
  CUSTOMER_SUPPORT
  SALES
  LEAD_QUALIFICATION
  MARKETING
  RESEARCH
  GENERAL
}

enum AIAgentStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  FLUTTERWAVE
  OTHER
}

enum UsageType {
  AI_MESSAGE
  AI_GENERATION
  CUSTOMER_MESSAGE
  LEAD_CREATED
  AUTOMATION_RUN
  API_REQUEST
}

/**
 * =========================================================
 * IDENTITY
 * =========================================================
 */

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   BusinessMember[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]       @relation("UserAuditLogs")

  @@index([status])
  @@index([createdAt])
}

model Business {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  websiteUrl  String?
  email       String?
  phone       String?
  logoUrl     String?
  timezone    String         @default("Africa/Lagos")
  currency    String         @default("NGN")
  country     String         @default("Nigeria")
  status      BusinessStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members            BusinessMember[]
  channels           ChannelConnection[]
  customers          Customer[]
  conversations      Conversation[]
  leads              Lead[]
  products           Product[]
  services           Service[]
  faqs               FAQ[]
  knowledgeDocuments KnowledgeDocument[]
  aiAgents           AIAgent[]
  automations        Automation[]
  chatbotWidgets     ChatbotWidget[]
  subscription       Subscription?
  payments           Payment[]
  usageRecords       UsageRecord[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([createdAt])
}

model BusinessMember {
  id         String         @id @default(uuid())
  businessId String
  userId     String
  role       MembershipRole @default(STAFF)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

/**
 * =========================================================
 * CHANNELS
 * =========================================================
 */

model ChannelConnection {
  id         String        @id @default(uuid())
  businessId String
  channel    ChannelType
  status     ChannelStatus @default(CONNECTING)

  externalAccountId String?
  externalPageId    String?
  accountName       String?
  username          String?

  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers     CustomerIdentity[]
  conversations Conversation[]

  @@unique([businessId, channel, externalAccountId])
  @@index([businessId])
  @@index([businessId, channel])
  @@index([status])
}

/**
 * =========================================================
 * CUSTOMERS / CRM
 * =========================================================
 */

model Customer {
  id         String  @id @default(uuid())
  businessId String
  firstName  String?
  lastName   String?
  fullName   String?
  email      String?
  phone      String?
  avatarUrl  String?

  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities    CustomerIdentity[]
  conversations Conversation[]
  leads         Lead[]

  @@index([businessId])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@index([createdAt])
}

model CustomerIdentity {
  id                  String   @id @default(uuid())
  customerId          String
  channelConnectionId String
  externalId          String
  username            String?
  displayName         String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)

  @@unique([channelConnectionId, externalId])
  @@index([customerId])
  @@index([externalId])
}

model Conversation {
  id                  String @id @default(uuid())
  businessId          String
  customerId          String
  channelConnectionId String

  aiAgentId String?

  subject   String?
  status    ConversationStatus @default(OPEN)
  aiEnabled Boolean            @default(true)

  assignedToId String?

  lastMessageAt DateTime?
  resolvedAt    DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  aiAgent           AIAgent?          @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([businessId])
  @@index([customerId])
  @@index([channelConnectionId])
  @@index([businessId, status])
  @@index([lastMessageAt])
}

model Message {
  id             String @id @default(uuid())
  conversationId String

  externalMessageId String?

  direction  MessageDirection
  senderType MessageSenderType
  type       MessageType       @default(TEXT)

  content  String?
  mediaUrl String?

  aiGenerated  Boolean @default(false)
  aiModel      String?
  aiConfidence Float?

  metadata Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([senderType])
}

/**
 * =========================================================
 * LEADS
 * =========================================================
 */

model Lead {
  id         String  @id @default(uuid())
  businessId String
  customerId String?

  title       String
  description String?

  status LeadStatus @default(NEW)
  source LeadSource @default(OTHER)

  value    Decimal? @db.Decimal(18, 2)
  currency String   @default("NGN")

  assignedToId String?

  notes    String?
  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  wonAt     DateTime?
  lostAt    DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@index([source])
}

/**
 * =========================================================
 * PRODUCTS & SERVICES
 * =========================================================
 */

model Product {
  id         String @id @default(uuid())
  businessId String

  name        String
  slug        String
  description String?

  sku      String?
  price    Decimal @db.Decimal(18, 2)
  currency String  @default("NGN")

  stockQuantity Int           @default(0)
  status        ProductStatus @default(ACTIVE)

  imageUrl String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, status])
  @@index([sku])
}

model Service {
  id         String @id @default(uuid())
  businessId String

  name        String
  slug        String
  description String?

  price    Decimal? @db.Decimal(18, 2)
  currency String   @default("NGN")

  active Boolean @default(true)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, active])
}

/**
 * =========================================================
 * BUSINESS KNOWLEDGE
 * =========================================================
 */

model FAQ {
  id         String @id @default(uuid())
  businessId String

  question String
  answer   String

  category String?
  active   Boolean @default(true)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, active])
}

model KnowledgeDocument {
  id         String @id @default(uuid())
  businessId String

  name        String
  description String?
  type        KnowledgeType @default(DOCUMENT)

  content   String?
  sourceUrl String?

  active Boolean @default(true)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, active])
}

/**
 * =========================================================
 * AI WORKFORCE
 * =========================================================
 */

model AIAgent {
  id         String @id @default(uuid())
  businessId String

  name        String
  description String?

  type   AIAgentType   @default(GENERAL)
  status AIAgentStatus @default(DRAFT)

  systemPrompt String?
  instructions String?

  model       String?
  temperature Float?

  settings Json?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  automations    Automation[]
  chatbotWidgets ChatbotWidget[]

  @@index([businessId])
  @@index([businessId, type])
  @@index([businessId, status])
}

model Automation {
  id         String  @id @default(uuid())
  businessId String
  aiAgentId  String?

  name        String
  description String?

  status AutomationStatus @default(DRAFT)

  trigger String
  action  String

  configuration Json?

  lastRunAt DateTime?
  nextRunAt DateTime?
  runCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aiAgent  AIAgent? @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([nextRunAt])
}

/**
 * =========================================================
 * BILLING / SUBSCRIPTIONS
 * =========================================================
 */

model Subscription {
  id         String @id @default(uuid())
  businessId String @unique

  plan   String
  status SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  trialEndsAt DateTime?
  cancelledAt DateTime?

  provider               PaymentProvider?
  externalSubscriptionId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([externalSubscriptionId])
}

model Payment {
  id         String @id @default(uuid())
  businessId String

  provider PaymentProvider
  status   PaymentStatus   @default(PENDING)

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("NGN")

  reference             String
  externalTransactionId String?

  description String?

  metadata Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([provider, reference])
  @@index([businessId])
  @@index([businessId, status])
  @@index([externalTransactionId])
}

model UsageRecord {
  id         String @id @default(uuid())
  businessId String

  type UsageType

  quantity Int      @default(1)
  unitCost Decimal? @db.Decimal(18, 6)

  metadata Json?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, type])
  @@index([createdAt])
}

/**
 * =========================================================
 * AUTHENTICATION
 * =========================================================
 */

model RefreshToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * =========================================================
 * AUDIT
 * =========================================================
 */

model AuditLog {
  id String @id @default(uuid())

  businessId String?
  userId     String?

  action   String
  entity   String?
  entityId String?

  description String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

/**
 * =========================================================
 * CHATBOT WIDGETS
 * =========================================================
 */

model ChatbotWidget {
  id         String  @id @default(uuid())
  widgetId   String  @unique
  businessId String
  aiAgentId  String?

  name           String  @default("BizPilot Assistant")
  logoUrl        String?
  primaryColor   String  @default("#2563EB")
  secondaryColor String  @default("#0F172A")
  welcomeMessage String  @default("Hello! How can we help you today?")
  greeting       String  @default("Chat with us")
  position       String  @default("bottom-right")

  enabled Boolean @default(true)

  allowedDomains Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aiAgent  AIAgent? @relation(fields: [aiAgentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([aiAgentId])
}
